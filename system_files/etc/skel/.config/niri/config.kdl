// air-os: niri leggero per MacBook Air 2017 (1440x900, touchpad + tastiera).
// Dux Shell parte come servizio utente (dms.service), non da qui.

input {
    keyboard {
        xkb {
            layout "us"
        }
        numlock
    }
    touchpad {
        tap
        dwt
        natural-scroll
        accel-profile "adaptive"
        scroll-method "two-finger"
        click-method "clickfinger"
    }
    focus-follows-mouse max-scroll-amount="0%"
}

output "eDP-1" {
    scale 1
}

layout {
    gaps 6
    center-focused-column "never"
    preset-column-widths {
        proportion 0.5
        proportion 1.0
    }
    default-column-width { proportion 1.0; }
    focus-ring {
        width 2
    }
    border {
        off
    }
}

// Niente animazioni: meno lavoro per la HD 6000 e meno batteria
animations {
    off
}

gestures {
    hot-corners {
        off
    }
}

prefer-no-csd
hotkey-overlay {
    skip-at-startup
}
screenshot-path "~/Immagini/Screenshot-%Y-%m-%d_%H-%M-%S.png"

// Finestre di Dux Shell (app-id nuovo dopo il cambio di nome)
window-rule {
    match app-id=r#"^dev\.duxlabs\.shell"#
    open-floating true
}

layer-rule {
    match namespace="^dms:"
    shadow { off; }
}

binds {
    Mod+Slash { show-hotkey-overlay; }

    // Dux Shell
    Mod+Space hotkey-overlay-title="Avvia app" { spawn "dms" "ipc" "call" "spotlight" "toggle"; }
    Mod+V hotkey-overlay-title="Appunti" { spawn "dms" "ipc" "call" "clipboard" "toggle"; }
    Mod+Escape hotkey-overlay-title="Blocca" { spawn "dms" "ipc" "call" "lock" "lock"; }
    Mod+Shift+E hotkey-overlay-title="Spegni/esci" { spawn "dms" "ipc" "call" "powermenu" "toggle"; }
    Mod+Shift+L hotkey-overlay-title="Contrasto al sole" { spawn "/usr/bin/air-contrast"; }

    // App
    Mod+Return hotkey-overlay-title="Terminale" { spawn "foot"; }
    Mod+E hotkey-overlay-title="File" { spawn "thunar"; }

    // Tasti multimediali e luminosità
    XF86AudioRaiseVolume allow-when-locked=true { spawn "dms" "ipc" "call" "audio" "increment" "5"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn "dms" "ipc" "call" "audio" "decrement" "5"; }
    XF86AudioMute allow-when-locked=true { spawn "dms" "ipc" "call" "audio" "mute"; }
    XF86MonBrightnessUp allow-when-locked=true { spawn "brightnessctl" "-q" "set" "5%+"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn "brightnessctl" "-q" "set" "5%-"; }
    XF86KbdBrightnessUp { spawn "brightnessctl" "-q" "-d" "smc::kbd_backlight" "set" "10%+"; }
    XF86KbdBrightnessDown { spawn "brightnessctl" "-q" "-d" "smc::kbd_backlight" "set" "10%-"; }

    // Finestre
    Mod+Q { close-window; }
    Mod+Left { focus-column-left; }
    Mod+Right { focus-column-right; }
    Mod+Up { focus-window-up; }
    Mod+Down { focus-window-down; }
    Mod+Shift+Left { move-column-left; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+Up { move-window-up; }
    Mod+Shift+Down { move-window-down; }
    Mod+Page_Up { focus-workspace-up; }
    Mod+Page_Down { focus-workspace-down; }
    Mod+Shift+Page_Up { move-column-to-workspace-up; }
    Mod+Shift+Page_Down { move-column-to-workspace-down; }
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+Shift+1 { move-column-to-workspace 1; }
    Mod+Shift+2 { move-column-to-workspace 2; }
    Mod+Shift+3 { move-column-to-workspace 3; }
    Mod+Shift+4 { move-column-to-workspace 4; }
    Mod+R { switch-preset-column-width; }
    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+W { toggle-window-floating; }
    Mod+O repeat=false { toggle-overview; }

    // Rotella e trackpad sulle aree di lavoro
    Mod+WheelScrollDown cooldown-ms=150 { focus-workspace-down; }
    Mod+WheelScrollUp cooldown-ms=150 { focus-workspace-up; }

    Print { screenshot; }
    Mod+Shift+P { power-off-monitors; }
}
